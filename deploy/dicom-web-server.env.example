# dicom-web-server production baseline
# Copy into deployment secrets/config management and adjust paths.

DICOM_WEB_BIND=0.0.0.0:8080
DICOM_WEB_STORAGE_WAL=./state/dicom-web/storage.wal
DICOM_WEB_STORAGE_WAL_MAX_BYTES=134217728
DICOM_WEB_STORAGE_WAL_MAX_ROTATED_FILES=3

# Security defaults (release profile)
DICOM_WEB_TLS_POLICY=require_tls
DICOM_WEB_TRANSPORT_SECURITY=tls
DICOM_WEB_AUTH_MODE=deny_all

# Route latency budgets (ms): qido/wado/stow p95/p99 percentiles
DICOM_WEB_QIDO_P95_LATENCY_MS=250
DICOM_WEB_QIDO_P99_LATENCY_MS=500
DICOM_WEB_WADO_P95_LATENCY_MS=400
DICOM_WEB_WADO_P99_LATENCY_MS=800
DICOM_WEB_STOW_P95_LATENCY_MS=1200
DICOM_WEB_STOW_P99_LATENCY_MS=2400
