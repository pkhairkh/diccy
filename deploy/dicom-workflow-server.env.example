# dicom-workflow-server production baseline
# Copy into deployment secrets/config management and adjust paths.

DICOM_WORKFLOW_BIND=0.0.0.0:8082
DICOM_WORKFLOW_WORKLIST_STATE_PATH=./state/workflow/worklist.snapshot
DICOM_WORKFLOW_MPPS_STATE_PATH=./state/workflow/mpps.snapshot
DICOM_WORKFLOW_SNAPSHOT_MAX_BYTES=33554432
DICOM_WORKFLOW_SNAPSHOT_MAX_ROTATED_FILES=2

# Security defaults (release profile)
DICOM_WORKFLOW_TRANSPORT_SECURITY=tls
DICOM_WORKFLOW_AUTH_MODE=token
DICOM_WORKFLOW_SECRET_DIR=/var/run/workflow-secrets
DICOM_WORKFLOW_AUTH_TOKEN_PATH=auth-token
DICOM_WORKFLOW_TLS_CERT_PATH=tls.crt
DICOM_WORKFLOW_TLS_KEY_PATH=tls.key
